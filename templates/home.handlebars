<!DOCTYPE html>
<html lang="{{language}}">
{{> head }}
<body>

    <img id="crowd2" src="/assets/img/crowd_2.jpg" /> 
    
    {{> header}}
    <main id="app">

        {{> intro}}

        <section id="why" class="container flex-centered">

            <div class="container-large flex-row">

                {{#each collections.why}}
                    <article id="{{this.id}}" class="block" author="{{this.author}}">
                        <span class="tag">{{this.custom.subtitle}}</span>
                        <h3>{{this.title}}</h3>
                        {{{this.custom.summary}}}
                        <a href=".{{this.path}}">Meer over {{this.custom.subtitle}}</a>
                    </article>
                {{/each}}

            </div>

        </section>

        <section class="intermezzo container flex-centered">
        
            <article class="container container-large flex-centered">
                <h3 text-scramble style="display: grid; grid-template-columns: repeat(24, 32px); gap: 4px; width: 860px;">
                    Wij maken cryptografie toegankelijk voor iedere organisatie. Zware wiskunde, simpel in gebruik.
                </h3>
            </article>
        </section>

         <section id="how" class="container flex-centered">

            <h2 class="header">Hoe het werkt</h2>
            <div class="tabs">
                <input type="radio" name="how" id="tr" checked="">
                <label for="tr" class="tab">Respondent</label>
                <input type="radio" name="how" id="to">
                <label for="to" class="tab">Organisator</label>
            </div>

            <div id="respondent" class="row-wrap">
                <div class="container-large flex-row">
                    {{#each collections.how-respondent}}
                        <article class="block ordered">
                            <h3>{{this.title}}</h3>
                            {{{this.content}}}
                        </article>
                    {{/each}}
                </div>
            </div>

            <div id="organisor" class="row-wrap">
                <div class="container-large flex-row">
                    {{#each collections.how-organisor}}
                        <article class="block ordered">
                            <h3>{{this.title}}</h3>
                            {{{this.content}}}
                        </article>
                    {{/each}}
                </div>
            </div>

        </section>
      
    </main>

    {{> footer }}
</body>
    {{> foot }} 
</html>
