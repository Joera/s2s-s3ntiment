<section id="intro" class="container flex-centered">  
        <article class="container container-large flex-centered">
                <h2>{{stripHTML title}}</h2>
                <p><span>{{stripHTML content}}</span></p>
                
                <a href="{{#if (eq locale 'nl')}}/nl/contact{{/if}}{{#if (eq locale 'en')}}/contact{{/if}}">
                        <button class="btn-primary">
                                {{#if (eq locale 'nl')}}Neem contact op{{/if}}
                                {{#if (eq locale 'en')}}Get in touch{{/if}}
                        </button>
                </a>
        </article>
</section> 