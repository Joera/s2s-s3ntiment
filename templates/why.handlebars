<!DOCTYPE html>
<html lang="{{language}}">
{{> head }}

<body id="page">
    {{> header}}
    <main id="page">
          
            <article class="page">   

                <section id="page-header">
                    <span class="tag">{{custom.slug}}</span>
                    <h2>{{title}}</h2> 
                </section> 

                {{{content}}}
                       
            </article>

            <section id="links" class="container container-large flex-centered flex-row">

                {{#each (prevNext collections.why position)}}
                    <a href="{{this.path}}">
                        <h4>Meer over {{this.slug}}</h4>
                    </a>
                {{/each}}

            </section>
        
    </main>
    {{> footer }}
</body>
    {{> foot }} 
</html>