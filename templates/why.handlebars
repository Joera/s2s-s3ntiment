<!DOCTYPE html>
<html lang="{{language}}">
{{> head }}

<body id="page">
    {{> header}}
    <main id="page">
          
            <article class="page">   

                <section id="page-header">
                    <span class="tag">{{custom.subtitle}}</span>
                    <h2>{{title}}</h2> 
                </section> 

                {{{content}}}
                       
            </article>

            <section class="container container-large flex-centered">

                {{#each collections.why}}
                    <article id="{{this.id}}" class="block" author="{{this.author}}">
                        <span class="tag">{{this.custom.subtitle}}</span>
                        <h3>{{this.title}}</h3>
                        {{{this.custom.summary}}}
                        <a href=".{{this.path}}">Meer over {{this.custom.subtitle}}</a>
                    </article>
                {{/each}}

            </section>
        
    </main>
    {{> footer }}
</body>
    {{> foot }} 
</html>