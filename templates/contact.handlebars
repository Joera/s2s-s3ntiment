<!DOCTYPE html>
<html lang="{{language}}">
{{> head }}

<body id="contact">
    {{> header}}
    <main id="page">
        
        <article class="page">   
            <section id="page-header">
                <span class="tag">{{custom.subtitle}}</span>
                <h2>{{title}}</h2> 
            </section> 
            {{{content}}} 
        </article>


        <section id="page_container" class="container small_container">
            <div id="contact-form-wrapper">
                <form id="contact-form" action="https://formsubmit.co/ajax/joera@joeramulders.com" method="POST">
                    <input type="hidden" name="_captcha" value="false">
                    <div class="form-group">
                        <label for="contact-name">Naam</label>
                        <input type="text" id="contact-name" name="name" required autocomplete="name">
                        <span class="field-error" id="error-name"></span>
                    </div>
                    <div class="form-group">
                        <label for="contact-email">E-mail</label>
                        <input type="email" id="contact-email" name="email" required autocomplete="email">
                        <span class="field-error" id="error-email"></span>
                    </div>
                    <div class="form-group">
                        <label for="contact-message">Bericht</label>
                        <textarea id="contact-message" name="message" rows="6" required></textarea>
                        <span class="field-error" id="error-message"></span>
                    </div>
                    <div class="form-feedback" id="form-feedback" aria-live="polite"></div>
                    <button type="submit" id="contact-submit">Verstuur</button>
                </form>
            </div>

        </section>
    </main>
    {{> footer }}
</body>
    {{> foot }}
    <script src="/assets/js/contact.js"></script>
</html>
