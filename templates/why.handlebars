<!DOCTYPE html>
<html lang="{{locale}}">
{{> head }}

<body id="page">
    {{> header this}}
    <main id="page">
          
            <article class="page">   

                <section id="page-header">
                    <span class="tag">{{custom.subtitle}}</span>
                    <h2>{{title}}</h2> 
                </section> 

                {{{content}}}
                       
            </article>

            <section id="links" class="container container-large flex-centered flex-row">

                {{#each (prevNext collections.why position)}}
                    <a href="{{this.path}}">
                        <h4>Meer over {{this.slug}}</h4>
                        <svg class="triangle" viewBox="0 0 100 100" preserveAspectRatio="none">
                            <polygon points="0,50 100,0 100,100" />
                        </svg>
                    </a>
                {{/each}}

            </section>
        
    </main>
    {{> footer }}
</body>
    {{> foot }} 
</html>